# ============================================================
# Environment Variables untuk Vercel
# Vercel Dashboard > Project > Settings > Environment Variables
# JANGAN commit file berisi nilai asli ke Git.
# ============================================================

APP_NAME=SIUKS
APP_ENV=production
APP_DEBUG=false
# Buat dengan: php artisan key:generate --show   (WAJIB key baru, jangan pakai key lokal)
APP_KEY=base64:ISI_DENGAN_KEY_BARU
APP_URL=https://NAMA-PROJECT-ANDA.vercel.app
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

SESSION_SECURE_COOKIE=true

# ---------- OPSI A: Aiven for MySQL ----------
DB_CONNECTION=mysql
DB_HOST=xxxx-xxxx.a.aivencloud.com
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=ISI_PASSWORD_AIVEN
DB_COLLATION=utf8mb4_unicode_ci
# Isi dengan seluruh isi file ca.pem dari Aiven (termasuk baris BEGIN/END CERTIFICATE)
DB_SSL_CA="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# ---------- OPSI B: Aiven for PostgreSQL (free plan) ----------
# DB_CONNECTION=pgsql
# DB_HOST=xxxx-xxxx.a.aivencloud.com
# DB_PORT=12345
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=ISI_PASSWORD_AIVEN
